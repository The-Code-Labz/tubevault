# Server
PORT=4050
NODE_ENV=development

# Storage backend: supabase | r2
STORAGE_BACKEND=supabase

# Supabase (REQUIRED — also backs authentication regardless of storage backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Created as a PRIVATE bucket (auto-migrated to private if it already exists public).
SUPABASE_BUCKET=videos
# TTL (seconds) for signed stream URLs returned by GET /api/videos/:id/stream.
# SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Public anon key, safe to expose client-side (unlike SUPABASE_SERVICE_KEY above).
# The frontend fetches this from the backend at RUNTIME via GET /api/config, so
# just set it here — no build-args, no CI secrets, no rebuild needed to change it.
SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 (required if STORAGE_BACKEND=r2)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=videos
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the default Docker/production setup).
ALLOWED_ORIGIN=

# Download limits
MAX_FILE_SIZE_BYTES=5368709120
MAX_CONCURRENT_DOWNLOADS=2

# yt-dlp tuning (optional)
# Auto-update yt-dlp on startup? true | false
YTDLP_AUTO_UPDATE=true
# Force a specific format selector. Default tries bestvideo+bestaudio, then best mp4, then worst.
# YTDLP_FORMAT=best
# Some sites (RedTube, PornHub, etc.) need a real browser user-agent or cookies to extract metadata.
# YTDLP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ..."
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES_FILE=./cookies.txt
# YTDLP_REFERER=https://www.redtube.com
# Extra args passed to yt-dlp, e.g. --geo-bypass, --verbose
# YTDLP_CUSTOM_ARGS=--verbose

# Paths (optional — defaults work for Docker)
# DOWNLOAD_DIR=/tmp/tubevault-downloads
# DB_PATH=./data/videos.json

# Docker image tag to pull (docker-compose.yml no longer builds locally —
# the image is published by .github/workflows/docker.yml on every push to main).
# Options: latest | main | sha-<short> | a semver tag e.g. v1.2.3
TUBEVAULT_IMAGE_TAG=latest

# Traefik reverse proxy (optional — only used by the `labels:` block in
# docker-compose.yml; ignored if you're not running Traefik)
TUBEVAULT_HOSTNAME=tubevault.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=cloudflare

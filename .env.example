# Server
PORT=4050
NODE_ENV=development

# Storage backend: supabase | r2
STORAGE_BACKEND=supabase

# Supabase (REQUIRED — also backs authentication regardless of storage backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Created as a PRIVATE bucket (auto-migrated to private if it already exists public).
SUPABASE_BUCKET=videos
# TTL (seconds) for signed stream URLs returned by GET /api/videos/:id/stream.
# SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Public anon key, safe to expose client-side (unlike SUPABASE_SERVICE_KEY above).
# The frontend fetches this from the backend at RUNTIME via GET /api/config, so
# just set it here — no build-args, no CI secrets, no rebuild needed to change it.
SUPABASE_ANON_KEY=your-anon-key

# REQUIRED — shared secret for POST /api/admin/invite (header: X-Admin-Key).
# The server refuses to boot without this set. Generate with e.g. `openssl rand -hex 32`.
# This is the invite mechanism for an invite-only vault — see README "Invite-only setup".
ADMIN_API_KEY=change-me-to-a-long-random-value

# Cloudflare R2 (required if STORAGE_BACKEND=r2)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=videos
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for same-origin only (the default Docker/production setup).
ALLOWED_ORIGIN=

# Download limits
MAX_FILE_SIZE_BYTES=5368709120
MAX_CONCURRENT_DOWNLOADS=2

# yt-dlp tuning (optional)
# Auto-update yt-dlp on startup? true | false
YTDLP_AUTO_UPDATE=true
# Force a specific format selector. Default tries bestvideo+bestaudio, then best mp4, then worst.
# YTDLP_FORMAT=best
# Some sites (RedTube, PornHub, etc.) need a real browser user-agent or cookies to extract metadata.
# YTDLP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ..."
# YTDLP_COOKIES_FROM_BROWSER=firefox
# Path INSIDE THE CONTAINER. Drop your exported cookies.txt at ./data/cookies.txt on the
# host (the ./data volume is already mounted to /app/data) — do NOT use a relative path,
# yt-dlp silently ignores --cookies if the file isn't found at this exact path.
# YTDLP_COOKIES_FILE=/app/data/cookies.txt
# YTDLP_REFERER=https://www.redtube.com
# Extra args passed to yt-dlp, e.g. --geo-bypass, --verbose
# YTDLP_CUSTOM_ARGS=--verbose

# Playwright fallback for adult / JS-heavy / HLS sites
# When yt-dlp fails on these domains, TubeVault launches Chromium, intercepts network traffic,
# grabs the .m3u8 / .mp4 / .ts manifest URL, and feeds it back to yt-dlp with proper headers.
PLAYWRIGHT_FALLBACK_ENABLED=true
# Regex of hostnames that should trigger the browser fallback. Add/remove sites as needed.
PLAYWRIGHT_FALLBACK_SITES=redtube|pornhub|xvideos|xhamster|spankbang|youporn|camwhores|eporner|xnxx
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
# Use playwright-extra + puppeteer-extra-plugin-stealth if installed
PLAYWRIGHT_STEALTH=false
# PLAYWRIGHT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) ..."
# PLAYWRIGHT_PROXY_SERVER=socks5://localhost:1080
# Cookie file for Playwright. Can be EITHER:
#   - JSON array (EditThisCookie / Cookie-Editor export)
#   - Netscape cookies.txt (most browser extensions)
# Path is INSIDE the container. The ./data volume is mounted at /app/data, so put the file
# at ./data/cookies.txt or ./data/cookies.json on the host and reference it as /app/data/... here.
# PLAYWRIGHT_COOKIES_FILE=/app/data/cookies.txt
# Override SameSite default for loaded cookies. Adult sites often need 'None' for cross-site players.
# PLAYWRIGHT_COOKIES_SAMESITE=None
# PLAYWRIGHT_EXTRA_ARGS=--disable-gpu

# Paths (optional — defaults work for Docker)
# DOWNLOAD_DIR=/tmp/tubevault-downloads
# DB_PATH=./data/videos.json

# Docker image tag. docker-compose.yml now builds locally from the Dockerfile by default
# (includes Chromium + Playwright). Set TUBEVAULT_IMAGE_TAG if you want to pull a
# prebuilt GHCR image instead. Options: latest | main | sha-<short> | v1.2.3
TUBEVAULT_IMAGE_TAG=latest

# Traefik reverse proxy (optional — only used by the `labels:` block in
# docker-compose.yml; ignored if you're not running Traefik)
TUBEVAULT_HOSTNAME=tubevault.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=cloudflare

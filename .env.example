# Server
PORT=4050
NODE_ENV=development

# Storage backend: supabase | r2
STORAGE_BACKEND=supabase

# Supabase Storage (required if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=videos

# Cloudflare R2 (required if STORAGE_BACKEND=r2)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=videos
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# Download limits
MAX_FILE_SIZE_BYTES=5368709120
MAX_CONCURRENT_DOWNLOADS=2

# Paths (optional — defaults work for Docker)
# DOWNLOAD_DIR=/tmp/tubevault-downloads
# DB_PATH=./data/videos.json
